{
  "name": "cmpc-libros",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w @cmpc/api\" \"npm run dev -w @cmpc/web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:cov": "npm run test:cov --workspaces",
    "test:integration": "npm run test:integration -w @cmpc/api",
    "db:generate": "npm run db:generate -w @cmpc/api",
    "db:migrate": "npm run db:migrate -w @cmpc/api",
    "db:seed": "npm run db:seed -w @cmpc/api",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "setup:env": "node scripts/setup-env.mjs",
    "security:rotate-local": "node scripts/rotate-local-secrets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "js-yaml": "^4.1.1"
  }
}
