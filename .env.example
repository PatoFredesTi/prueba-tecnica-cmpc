# Ejecuta npm run setup:env para generar .env con secretos propios.
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=
POSTGRES_DB=cmpc_libros
DB_PORT=55439
DATABASE_URL=postgresql://cmpc:GENERAR_CON_SETUP@localhost:55439/cmpc_libros?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=1h
# false para HTTP local; true al desplegar con HTTPS
SESSION_COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@cmpc.local
SEED_ADMIN_PASSWORD=
PORT=3000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# APP_ENV es independiente de NODE_ENV del contenedor
APP_ENV=local
SWAGGER_ENABLED=true
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
